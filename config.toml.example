# anvil configuration example
#
# Install as:
#   ${XDG_CONFIG_HOME:-$HOME/.config}/anvil/config.toml
#
# anvil preserves unknown and hand-authored sections when it saves a valid
# config. In-app writes are locked, revision-checked, and atomically replaced;
# stale windows cannot overwrite newer edits. Two known-good backups rotate as
# config.toml.bak and config.toml.bak.1. Malformed or schema-invalid files fall
# back to safe defaults for loading and are never overwritten by the settings UI.
# Validate without starting GTK: anvil --check-config

# Appearance. Built-in themes: default, light, solarized-dark,
# solarized-light, gruvbox-dark, gruvbox-light, dracula, nord.
theme = "default"
font = "SauceCodePro Nerd Font Mono 14"
font_scale = 1.0
opacity = 0.95
scrollback = 5000

# Backend and layout.
terminal_mode = "block"     # "block" or "vte"; applies to new/restored local panes
tab_placement = "sidebar"   # "sidebar" or "top"
sidebar_view = "tabs"       # "tabs" or "files"
sidebar_visible = true
sidebar_width = 220
tab_width = 180

# Shell selection and commands automatically submitted in every new tab.
# When shell is omitted, anvil tries jsh, bash -l, then sh.
# shell = "/bin/bash"
# Separate startup commands with a comma followed by a space.
# startup_commands = "cd /path/to/project, printf 'ready\\n'"

# When to look for a newer jsh: "startup" checks the network on every launch,
# "daily" (default) reuses the installer cache shared by every jterm on this
# machine, "never" disables the check. The check only decides whether the offer
# appears; installing always stays an explicit choice (palette: "Install or
# update jsh").
jsh_update_check = "daily"

# Lightweight command-only JSONL history used by Ctrl+Shift+H, the palette, and
# optional AI context. The default path is under $XDG_STATE_HOME/anvil/.
command_history_enabled = true
# This must be an absolute path; '~' is not expanded here.
# command_history_path = "/absolute/path/to/history.jsonl"
command_history_max_entries = 10000

# Block view behavior and optional full-output persistence.
block_compact = false
max_visible_blocks = 200
ansi_cache_capacity = 256
output_batch_min_ms = 10
output_batch_max_ms = 100
lazy_load_threshold = 1000
truncation_threshold_lines = 50000
finished_block_viewport_rows = 24
finished_block_max_expanded_rows = 5000
max_collapsed_output_lines = 25
virtual_scroll_margin = 1
# Unlike command history, this binary file can contain terminal output. It is
# disabled unless an absolute path is configured; '~' is not expanded here.
# block_history_path = "/absolute/path/to/anvil-history.bin"
block_history_compress = true
preserve_live_scrollback = false
show_repo_strip = true

# Bottom status bar: cwd, git branch, last command's status/duration, grid
# size, and tab position. The same key toggles it in every jterm.
bottom_bar = true

# Terminal protocol and clipboard behavior.
mouse_reporting_enabled = true
focus_reporting_enabled = true
scroll_reporting_enabled = true
allow_remote_clipboard_write = false

# Desktop notifications for commands that run at least the threshold duration.
notify_long_blocks = true
notify_long_block_threshold_ms = 10000

# Optional AI surfaces. Credentials (ANVIL_AI_API_KEY, ANTHROPIC_API_KEY,
# OPENAI_API_KEY, or OLLAMA_API_KEY) remain environment-only and are never
# written by anvil. The generic key takes precedence. Provider aliases
# `claude`, `openai`, and `openai_compatible` are accepted and normalized.
# Environment overrides take precedence over this file: ANVIL_AI_PROVIDER, ANVIL_AI_MODEL,
# ANVIL_AI_BASE_URL, ANVIL_AI_MAX_TOKENS, ANVIL_AI_REDACT_SECRETS, and
# ANVIL_AI_STREAM, ANVIL_AGENT_AUTO_APPROVE_READONLY, and
# ANVIL_COMMAND_CORRECTION_ENABLED. Enabled correction may make an AI fallback
# request after a narrowly classified failure; no candidate is accepted automatically.
ai_enabled = true
agent_enabled = true
agent_max_turns = 20
# Retired compatibility key. `true` is ignored; every proposal needs approval.
agent_auto_approve_readonly = false
command_correction_enabled = true
ai_provider = "anthropic"       # anthropic | openai-compatible | ollama
ai_model = "claude-sonnet-4-6"
ai_base_url = "https://api.anthropic.com"
ai_max_tokens = 1024             # 1 .. 32768
ai_redact_secrets = true
ai_stream = true                 # stream session AI panel replies as they generate

# Explicitly start with no saved remote targets. Hosts can be added and removed
# from the settings dialog, which rewrites this key; to add targets by hand,
# remove this line and uncomment one or more [[remote_hosts]] examples at the
# end of this file.
remote_hosts = []

# Optional color overrides. The 16-color palette still comes from the theme.
# [colors]
# foreground = "#f8f7e9"
# background = "#121616"
# cursor = "#7fb80e"
# cursor_foreground = "#1b315e"

# Every entry is optional. The first group shows active defaults. Overriding an
# action replaces all of that action's built-in aliases with one shortcut.
[keybindings]
# new_tab = "Ctrl+Shift+T"
# close_pane_or_tab = "Ctrl+Shift+W"
# copy = "Ctrl+Shift+C"
# paste = "Ctrl+Shift+V"
# font_increase = "Ctrl+equal"
# font_decrease = "Ctrl+minus"
# font_reset = "Ctrl+0"
# opacity_increase = "Ctrl+Alt+equal"
# opacity_decrease = "Ctrl+Alt+minus"
# toggle_search = "Ctrl+Shift+F"
# cross_block_search = "Ctrl+Shift+G"
# toggle_command_palette = "Ctrl+Shift+P"
# open_history_palette = "Ctrl+Shift+H"
# toggle_settings = "Ctrl+Shift+O"
# reload_config = "Ctrl+Shift+R"
# toggle_sidebar = "Ctrl+backslash"
# split_horizontal = "Ctrl+Shift+E"
# split_vertical = "Ctrl+Shift+D"
# prev_tab = "Ctrl+PageUp"
# next_tab = "Ctrl+PageDown"
# scroll_up = "Ctrl+Up"
# scroll_down = "Ctrl+Down"
# show_remote_picker = "Ctrl+Shift+S"
# resize_pane_left = "Ctrl+Shift+Alt+Left"
# resize_pane_right = "Ctrl+Shift+Alt+Right"
# resize_pane_up = "Ctrl+Shift+Alt+Up"
# resize_pane_down = "Ctrl+Shift+Alt+Down"
# toggle_pane_zoom = "Ctrl+Shift+Z"
# move_pane_to_new_tab = "Ctrl+Shift+!"
# focus_pane_left = "Ctrl+Alt+Left"
# focus_pane_right = "Ctrl+Alt+Right"
# focus_pane_up = "Ctrl+Alt+Up"
# focus_pane_down = "Ctrl+Alt+Down"
# filter_tabs = "Ctrl+Shift+L"
# toggle_tab_placement = "Ctrl+Alt+B"
# filter_failed_blocks = "Ctrl+Shift+X"
# clear_block_filter = "Ctrl+Shift+N"
# select_all_blocks = "Ctrl+Shift+A"
# clear_blocks = "Ctrl+Shift+K"
# reinput_selected_commands = "Ctrl+Shift+I"
# toggle_debug_dashboard = "F12"
# open_ai_panel = "Ctrl+Shift+Alt+A"
# ask_ai_about_selected_block = "Ctrl+Shift+Q"
# open_workflows = "Ctrl+Shift+M"
# open_agent = "Ctrl+Alt+G"

# These actions have no default shortcut. The values below are examples only;
# choose combinations that do not collide with the defaults above.
# close_tab = "Ctrl+Alt+W"
# open_palette = "Ctrl+Alt+P"
# close_selected_tabs = "Ctrl+Alt+X"
# move_tab_left = "Ctrl+Alt+PageUp"
# move_tab_right = "Ctrl+Alt+PageDown"
# duplicate_tab = "Ctrl+Alt+U"
# toggle_tab_marked = "Ctrl+Alt+M"
# toggle_tab_pinned = "Ctrl+Alt+I"
# cycle_pane_focus_forward = "Ctrl+Alt+period"
# cycle_pane_focus_backward = "Ctrl+Alt+comma"
# filter_slow_blocks = "Ctrl+Shift+Alt+S"
# filter_pinned_blocks = "Ctrl+Shift+Alt+M"
# jump_to_prev_pinned = "Ctrl+Alt+comma"
# jump_to_next_pinned = "Ctrl+Alt+period"
# jump_to_prev_failed = "Ctrl+Shift+Alt+comma"
# jump_to_next_failed = "Ctrl+Shift+Alt+period"
# undo_clear_blocks = "Ctrl+Shift+Alt+U"
# export_session_markdown = "Ctrl+Shift+Alt+E"
# export_session_json = "Ctrl+Shift+Alt+J"

# Example remote profiles. Each `name` must be unique because session restore
# uses it as the stable profile identifier. Remove `remote_hosts = []` above
# before uncommenting. The settings dialog manages the same list, so hosts
# added there are saved as [[remote_hosts]] entries.
#
# An ssh target. Optional keys not shown: remote_shell (default "jsh"),
# login_shell, multiplex, and `session` for block-aware reconnect/resume on a
# compatible jsh installation.
# [[remote_hosts]]
# name = "staging"
# host = "server.example.com"
# user = "deploy"
# ssh_args = ["-p", "22"]
# deploy = "persist"
#
# A running Docker container: `host` names the container, and `docker` swaps
# ssh for `docker exec`. ssh_args, login_shell, and multiplex are ignored here.
# [[remote_hosts]]
# name = "dev-container"
# host = "dev-env"
# docker = true
# deploy = "persist"
#
# `deploy` covers the host that has no jsh on it. Blocks, cwd tracking, exit
# codes and the Commands timeline all come from jsh, so a destination with only
# bash quietly loses them.
#   "off"        (default) run remote_shell over ssh and take what is there
#   "persist"    place a verified static jsh there for the session and remove it
#                afterwards; jsh's dot-files and a cached binary stay in that
#                account's $HOME, so history survives and later tabs skip the
#                transfer
#   "incognito"  the same, with HOME pointed at a sandbox that is deleted on
#                exit, so the real remote $HOME is never written to — this is
#                what a shared account needs
# Neither mode edits the destination's .bashrc, .profile, or login shell, and
# neither needs root. `remote_shell` is ignored when deploy is on.
# deploy = "persist"
