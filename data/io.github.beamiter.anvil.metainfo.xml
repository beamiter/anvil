<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.beamiter.anvil</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>anvil</name>
  <summary>Block-aware terminal workspace for Linux</summary>
  <description>
    <p>
      anvil combines structured command blocks with a VTE compatibility
      backend, tabs, split panes, session restore, searchable history,
      workflows, executable notebooks, SSH sessions, and optional AI tools.
    </p>
    <ul>
      <li>Review-first command insertion and foreground-process close checks</li>
      <li>Cross-block search, command history, workflows, and notebooks</li>
      <li>Remote sessions, an asynchronous file tree, and multi-provider AI</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.beamiter.anvil.desktop</launchable>
  <developer id="io.github.beamiter">
    <name>beamiter</name>
  </developer>
  <url type="homepage">https://github.com/beamiter/anvil</url>
  <url type="bugtracker">https://github.com/beamiter/anvil/issues</url>
  <provides>
    <binary>anvil</binary>
  </provides>
  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
  </recommends>
  <content_rating type="oars-1.1"/>
  <!--
    No <releases> node on purpose. The repository has never been tagged (`git
    tag` is empty locally and on the remote), so an AppStream release entry
    would be a factual claim a packager or update checker cannot resolve to any
    source. frost states the family policy and frost/ember already follow it;
    add the entry in the same commit that creates the tag.
  -->
</component>
