+fn parse_report_format(args: &[OsString], usage: &str) -> Result<ReportFormat, String> {
+    match args {
+        [_] => Ok(ReportFormat::Human),
+        [_, flag] if flag == "--json" => Ok(ReportFormat::Json),
+        _ => Err(format!("usage: jterm1 {usage}")),
+    }
+}
+
